# Copy this file to .env on the server. Do not commit the real .env file.
# Use only letters and digits for the three secrets so they are safe in URLs.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
REDIS_PASSWORD=replace-with-a-long-random-alphanumeric-password
SESSION_SECRET=replace-with-a-long-random-alphanumeric-secret

# Set this to the final HTTPS URL before the first public login.
PUBLIC_URL=https://jmmredeem.online
# Exact IP addresses or CIDR blocks allowed to bypass application rate limits.
# Keep this limited to administrator addresses; it does not bypass authentication.
RATE_LIMIT_BYPASS_IPS=48.44.49.88
TZ=Asia/Shanghai
